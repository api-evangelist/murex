{
  "opencollection": "1.0.0",
  "info": {
    "name": "Murex MX.3 Market Data Accounting API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Accounting",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Murex List accounting entries",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.murex.com/v1/marketdata/accounting/entries",
            "params": [
              {
                "name": "portfolioId",
                "value": "",
                "type": "query",
                "description": "Portfolio or book identifier"
              },
              {
                "name": "fromDate",
                "value": "",
                "type": "query",
                "description": "Start date"
              },
              {
                "name": "toDate",
                "value": "",
                "type": "query",
                "description": "End date"
              },
              {
                "name": "eventType",
                "value": "",
                "type": "query",
                "description": "Filter by accounting event type"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Maximum number of results to return"
              },
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "Number of results to skip for pagination"
              }
            ]
          },
          "docs": "Retrieve accounting journal entries generated from trade and position events."
        }
      ]
    }
  ],
  "bundled": true
}