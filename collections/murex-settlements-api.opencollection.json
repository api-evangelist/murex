{
  "opencollection": "1.0.0",
  "info": {
    "name": "Murex MX.3 Market Data Accounting Settlements API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Settlements",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Murex List settlements",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.murex.com/v1/marketdata/settlements",
            "params": [
              {
                "name": "status",
                "value": "",
                "type": "query",
                "description": "Filter by settlement status"
              },
              {
                "name": "settlementDate",
                "value": "",
                "type": "query",
                "description": "Filter by settlement date"
              },
              {
                "name": "currency",
                "value": "",
                "type": "query",
                "description": "Filter by settlement currency"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Maximum number of results to return"
              },
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "Number of results to skip for pagination"
              }
            ]
          },
          "docs": "Retrieve settlement instructions and their processing status."
        },
        {
          "info": {
            "name": "Murex Get a settlement",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.murex.com/v1/marketdata/settlements/:settlementId",
            "params": [
              {
                "name": "settlementId",
                "value": "",
                "type": "path",
                "description": "Settlement unique identifier"
              }
            ]
          },
          "docs": "Retrieve details of a specific settlement instruction."
        },
        {
          "info": {
            "name": "Murex Instruct a settlement",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.murex.com/v1/marketdata/settlements/:settlementId/instruct",
            "params": [
              {
                "name": "settlementId",
                "value": "",
                "type": "path",
                "description": "Settlement identifier"
              }
            ]
          },
          "docs": "Send settlement instructions to the payment or securities settlement system."
        }
      ]
    }
  ],
  "bundled": true
}