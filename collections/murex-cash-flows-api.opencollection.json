{
  "opencollection": "1.0.0",
  "info": {
    "name": "Murex MX.3 Market Data Accounting Cash Flows API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Cash Flows",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Murex List cash flows",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.murex.com/v1/marketdata/cashflows",
            "params": [
              {
                "name": "portfolioId",
                "value": "",
                "type": "query",
                "description": "Portfolio or book identifier"
              },
              {
                "name": "fromDate",
                "value": "",
                "type": "query",
                "description": "Start date for cash flow period"
              },
              {
                "name": "toDate",
                "value": "",
                "type": "query",
                "description": "End date for cash flow period"
              },
              {
                "name": "currency",
                "value": "",
                "type": "query",
                "description": "Filter by currency"
              },
              {
                "name": "type",
                "value": "",
                "type": "query",
                "description": "Cash flow type filter"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Maximum number of results to return"
              },
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "Number of results to skip for pagination"
              }
            ]
          },
          "docs": "Retrieve projected and historical cash flows across portfolios."
        }
      ]
    }
  ],
  "bundled": true
}