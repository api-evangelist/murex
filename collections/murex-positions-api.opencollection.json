{
  "opencollection": "1.0.0",
  "info": {
    "name": "Murex MX.3 Market Data Accounting Positions API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Positions",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Murex List positions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.murex.com/v1/marketdata/positions",
            "params": [
              {
                "name": "portfolioId",
                "value": "",
                "type": "query",
                "description": "Portfolio or book identifier"
              },
              {
                "name": "deskId",
                "value": "",
                "type": "query",
                "description": "Trading desk identifier"
              },
              {
                "name": "assetClass",
                "value": "",
                "type": "query",
                "description": "Filter by asset class"
              },
              {
                "name": "instrumentId",
                "value": "",
                "type": "query",
                "description": "Filter by instrument identifier"
              },
              {
                "name": "asOfDate",
                "value": "",
                "type": "query",
                "description": "Position date"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Maximum number of results to return"
              },
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "Number of results to skip for pagination"
              }
            ]
          },
          "docs": "Retrieve portfolio positions with optional filtering by portfolio, asset class, instrument, and date."
        },
        {
          "info": {
            "name": "Murex Get a position",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.murex.com/v1/marketdata/positions/:positionId",
            "params": [
              {
                "name": "positionId",
                "value": "",
                "type": "path",
                "description": "Position unique identifier"
              }
            ]
          },
          "docs": "Retrieve details of a specific position."
        },
        {
          "info": {
            "name": "Murex Get position summary",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.murex.com/v1/marketdata/positions/summary",
            "params": [
              {
                "name": "portfolioId",
                "value": "",
                "type": "query",
                "description": "Portfolio or book identifier"
              },
              {
                "name": "deskId",
                "value": "",
                "type": "query",
                "description": "Trading desk identifier"
              },
              {
                "name": "groupBy",
                "value": "",
                "type": "query",
                "description": "Grouping dimension for aggregation"
              },
              {
                "name": "asOfDate",
                "value": "",
                "type": "query",
                "description": "Position date"
              }
            ]
          },
          "docs": "Retrieve aggregated position summary by portfolio, desk, asset class, or currency."
        }
      ]
    }
  ],
  "bundled": true
}